# Copy to .env and edit. start.sh refuses to launch if NODE*_HOST still
# contain the placeholder string CHANGE_ME.

# --- SSH from node0 (head) to the two workers ---
SSH_USER=ubuntu
SSH_PORT=22
# Optional extra ssh flags, e.g. -i /home/ubuntu/.ssh/id_ed25519
SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=accept-new"

# Hostnames or IPs you can SSH to. node0 is the machine that runs start.sh.
NODE0_HOST=CHANGE_ME
NODE1_HOST=CHANGE_ME
NODE2_HOST=CHANGE_ME

# Shared L2 ethernet IPs used for Gloo / TCPStore / vLLM --master-addr.
# This is the *management* NIC that can reach all three boxes, NOT a
# pairwise QSFP /24. Typical Spark LAN: enP7s7.
NODE0_IP=10.0.0.10
NODE1_IP=10.0.0.11
NODE2_IP=10.0.0.12
GLOO_IFACE=enP7s7

# Checkout path on every node (same relative layout). start.sh rsyncs
# this repo from node0 into NODE1_DIR / NODE2_DIR.
NODE0_DIR=
NODE1_DIR=
NODE2_DIR=
# If NODE*_DIR is empty, start.sh uses the directory that contains this file.

# --- Image ---
# Thin layer on Anemll 0.1.1 (CUTLASS MXFP4 convert + DeepSeek SiLU).
# Built locally by ./scripts/build-image.sh — no hosted binary.
DSPARK_VLLM_IMAGE=dspark-vllm-gx10:0.1.1-cutlass-ep
DSPARK_VLLM_BASE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1

# --- Weights ---
# Validated lane used SuperDeepseek abliterated (same 0731 geometry).
# Official 0731 should load if config.json matches (heads 64, experts 256,
# inter 2048, vocab 129280). Flip ABLITERATED=0 after you have that cache.
ABLITERATED=1
DSPARK_MODEL_OFFICIAL=deepseek-ai/DeepSeek-V4-Flash-0731
DSPARK_REVISION_OFFICIAL=9e165c30e2704aec5d9d593cce3eebd58bbef1cb
DSPARK_MODEL_ABLITERATED=Jiunsong/SuperDeepseek-V4-Flash-abliterated-MQ-2xDGX
DSPARK_REVISION_ABLITERATED=2a7dd6a12d46f752e290c6255140a42600897864
SERVED_MODEL_NAME=deepseek-v4-flash-0731
HF_HUB_OFFLINE=1

# --- Serve shape (measured E13 defaults) ---
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=8192
LONG_PREFILL_TOKEN_THRESHOLD=1024
GPU_MEMORY_UTILIZATION=0.835
MTP_NUM_TOKENS=5
DEFAULT_THINKING=off
VLLM_HOST=0.0.0.0
VLLM_PORT=8888
MASTER_PORT=25200
PROJECT=dsv4-0731-3n

# Optional bigger KV after a healthy first boot:
# GPU_MEMORY_UTILIZATION=0.87
# MAX_NUM_SEQS=6

# --- Parallelism (do not change unless you know why) ---
TENSOR_PARALLEL_SIZE=3
PIPELINE_PARALLEL_SIZE=1
DATA_PARALLEL_SIZE=1
ENABLE_EP=1
ENABLE_EPLB=1
EPLB_CONFIG={"num_redundant_experts":2}
MOE_BACKEND=flashinfer_cutlass
ALL2ALL_BACKEND=allgather_reducescatter
VLLM_DSV4_TP_PAD=heads
VLLM_DSV4_PAD_HEADS=72
VLLM_DSV4_PAD_GROUPS=9

# --- Fabric: NCCL mesh on the QSFP triangle ---
# Stock NCCL IB cannot treat a pairwise /24 triangle as dual-rail.
# TRANSPORT=mesh uses autoscriptlabs/nccl-mesh-plugin (built locally).
TRANSPORT=mesh
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1

# --- Mia / Anemll knobs that are load-bearing on 0.1.1 ---
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_PREFIX_CACHE_RETENTION_INTERVAL=4096
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
DSPARK_SUPPRESS_STOPS_IN_REASONING=1
DSPARK_SKIP_HOTFIX=0
DSPARK_SKIP_ISSUE22_HOTFIX=0
DSPARK_SKIP_SUPPRESS_STOPS_HOTFIX=0
CUTE_DSL_ARCH=sm_121a
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
